local Pages = {}
local CurrentTab = nil

function SwitchTab(name)
	local data = Pages[name]
	if not data then return end

	for _,v in pairs(Pages) do
		v.Page.Visible = false
		v.Button.BackgroundColor3 = C.side
		v.Button.TextColor3 = C.sub
	end

	data.Page.Visible = true
	data.Button.BackgroundColor3 = C.active
	data.Button.TextColor3 = C.text

	TopTitle.Text = string.upper(name)
	CurrentTab = name
end

function CreateTab(name)
	local Btn = New("TextButton",Side)
	Btn.Size = UDim2.new(1,-12,0,38)
	Btn.Text = name
	Btn.Font = Enum.Font.GothamSemibold
	Btn.TextSize = 14
	Btn.TextColor3 = C.sub
	Btn.BackgroundColor3 = C.side
	Btn.ZIndex = 999999
	Corner(Btn,10)

	local Page = New("ScrollingFrame",Content)
	Page.Position = UDim2.new(0,10,0,42)
	Page.Size = UDim2.new(1,-20,1,-52)
	Page.BackgroundTransparency = 1
	Page.BorderSizePixel = 0
	Page.ScrollBarThickness = 3
	Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Page.CanvasSize = UDim2.new(0,0,0,0)
	Page.Visible = false
	Page.ZIndex = 999999

	local Layout = New("UIListLayout",Page)
	Layout.Padding = UDim.new(0,8)

	Pages[name] = {
		Button = Btn,
		Page = Page
	}

	Btn.MouseButton1Click:Connect(function()
		SwitchTab(name)
	end)

	return Page
end

