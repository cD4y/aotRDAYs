end

function AddLabel(parent,text)
	local L = New("TextLabel",parent)
	L.Size = UDim2.new(1,-6,0,28)
	L.BackgroundColor3 = C.bg
	L.Text = text
	L.TextXAlignment = Enum.TextXAlignment.Left
	L.Font = Enum.Font.GothamSemibold
	L.TextSize = 13
	L.TextColor3 = C.text
	L.ZIndex = 999999
	Corner(L,10)
	Stroke(L)
	return L
end

function AddButton(parent,text,callback)
	local B = New("TextButton",parent)
	B.Size = UDim2.new(1,-6,0,36)
	B.Text = text
	B.Font = Enum.Font.GothamBold
	B.TextSize = 13
	B.TextColor3 = Color3.new(1,1,1)
	B.BackgroundColor3 = C.accent
	B.ZIndex = 999999
	Corner(B,10)

	B.MouseButton1Click:Connect(function()
		Tween(B,{BackgroundTransparency=.2},.08):Play()
		task.wait(.08)
		Tween(B,{BackgroundTransparency=0},.08):Play()

		if callback then
			callback()
		end
	end)

	return B
end

function AddToggle(parent,text,default,callback)
	local State = default

	local Holder = New("Frame",parent)
	Holder.Size = UDim2.new(1,-6,0,38)
	Holder.BackgroundColor3 = C.bg
	Holder.ZIndex = 999999
	Corner(Holder,10)
	Stroke(Holder)

	local T = New("TextLabel",Holder)
	T.Size = UDim2.new(1,-60,1,0)
	T.Position = UDim2.new(0,10,0,0)
	T.BackgroundTransparency = 1
	T.Text = text
	T.TextXAlignment = Enum.TextXAlignment.Left
	T.Font = Enum.Font.GothamSemibold
	T.TextSize = 13
	T.TextColor3 = C.text
	T.ZIndex = 999999

	local Track = New("Frame",Holder)
	Track.Size = UDim2.new(0,42,0,22)
	Track.Position = UDim2.new(1,-52,0.5,-11)
	Track.BackgroundColor3 = State and C.accent or C.side
	Track.ZIndex = 999999
	Corner(Track,99)

	local Knob = New("Frame",Track)
	Knob.Size = UDim2.new(0,18,0,18)
	Knob.Position = UDim2.new(0,State and 22 or 2,0.5,-9)
	Knob.BackgroundColor3 = Color3.new(1,1,1)
	Knob.ZIndex = 999999
	Corner(Knob,99)

	local Click = New("TextButton",Holder)
	Click.Size = UDim2.new(1,0,1,0)
	Click.Text = ""
	Click.BackgroundTransparency = 1
	Click.ZIndex = 999999

	local function Set(v)
		State = v
		Tween(Track,{BackgroundColor3=v and C.accent or C.side},.16):Play()
		Tween(Knob,{Position=UDim2.new(0,v and 22 or 2,0.5,-9)},.16):Play()

		if callback then
			callback(v)
		end
	end

	Click.MouseButton1Click:Connect(function()
		Set(not State)
	end)

	return {
		Set = Set,
		Get = function()
			return State
		end
	}
end

