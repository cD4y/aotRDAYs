local function CloseMenu()
	Tween(Main,{BackgroundTransparency=1},.18):Play()
	Tween(Scale,{Scale=.92},.18):Play()

	task.delay(.2,function()
		Main.Visible = false
		OpenBtn.Visible = true
		Tween(OpenBtn,{Position=UDim2.new(0,8,0.5,-17)},.2):Play()
	end)
end

local function ToggleMenu()
	if not Verified then return end

	if Main.Visible then
		CloseMenu()
	else
		OpenMenu()
	end
end

---------------------------------------------------
-- VERIFY
---------------------------------------------------
local function Verify()
	local txt = KeyBox.Text:lower():gsub("%s+","")

	if txt == "day" then
		Verified = true

		pcall(function()
			if writefile then
				writefile(KeyFile,"verified")
			end
		end)

		Toast("Key Accepted","success")

		Tween(KeyFrame,{Size=UDim2.new(0,290,0,0)},.2):Play()
		task.wait(.22)

		KeyFrame.Visible = false
		OpenMenu()
	else
		KeyBox.Text = ""
		Toast("Wrong Key","error")
		task.wait(.1)
		KeyBox:CaptureFocus()
	end
end

