function AddSection(parent,text)
	local L = New("TextLabel",parent)
	L.Size = UDim2.new(1,-6,0,24)
	L.BackgroundTransparency = 1
	L.Text = text
	L.TextXAlignment = Enum.TextXAlignment.Left
