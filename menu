function Toast(msg,tp)
	local col = C.accent
	if tp=="success" then col=C.success end
	if tp=="error" then col=C.error end
	if tp=="warn" then col=C.warn end

	local f = New("Frame",ToastHolder)
	f.Size = UDim2.new(0,0,0,38)
	f.BackgroundColor3 = C.panel
	f.ZIndex = 999999
	Corner(f,12)
	Stroke(f,col)

	local t = New("TextLabel",f)
	t.Size = UDim2.new(1,-12,1,0)
	t.Position = UDim2.new(0,8,0,0)
	t.BackgroundTransparency = 1
	t.Text = msg
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.Font = Enum.Font.GothamSemibold
	t.TextSize = 13
	t.TextColor3 = C.text
	t.ZIndex = 999999

	Tween(f,{Size=UDim2.new(0,300,0,38)},.22):Play()

	task.delay(2.4,function()
		Tween(f,{Size=UDim2.new(0,0,0,38)},.2):Play()
		task.wait(.22)
		f:Destroy()
	end)
end

