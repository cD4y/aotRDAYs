local function OpenMenu()
	Main.Visible = true
	Main.BackgroundTransparency = 1
	Scale.Scale = .92

	Tween(Main,{BackgroundTransparency=0},.2):Play()
	Tween(Scale,{Scale=1},.22):Play()

	OpenBtn.Visible = false
	Toast("Menu Opened","success")
